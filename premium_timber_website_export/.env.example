# =====================================================================
# PREMIUM TIMBER IMPORT/EXPORT - ENV CONFIGURATION EXAMPLE
# Copy this file to '.env.local' and fill in your keys.
# =====================================================================

# 1. Supabase (Database, Storage, & Authentication)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Set to 'true' to explicitly bypass local mock DB and use actual Supabase
NEXT_PUBLIC_USE_SUPABASE=false

# 2. Cloudinary (Media logs uploads)
# Get these from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=timber_inventory_preset

# 3. Razorpay (Payments & Orders integration)
# Get these from your Razorpay Dashboard -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 4. Marketing & Integrations
# WhatsApp Number with Country Code (no symbols, e.g., +91 98765 43210 -> 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Google Maps API Embed Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsAPIKeyHere

# 5. Admin Alert Email Service
# Settings for transactional inquiry & order notifications
EMAIL_SERVICE_HOST=smtp.mailgun.org
EMAIL_SERVICE_PORT=587
EMAIL_SERVICE_USER=postmaster@yourdomain.com
EMAIL_SERVICE_PASSWORD=your_smtp_password_here
EMAIL_SERVICE_FROM="Premium Timber Alerts" <alerts@premiumtimber.com>
